---
import KanaChart from '@/components/KanaChart.astro';
import { DAKUTEN_ROWS, GOJUON_ROWS, KANA_MARKS, YOON_ROWS } from '@/constants/kana';
import { localeFromParams, localeRoutes } from '@/i18n/routing';
import { pickLocale, useTranslations } from '@/i18n/t';
import SiteLayout from '@/layouts/SiteLayout.astro';
import Container from '@/ui/Container.astro';
import Furigana from '@/ui/Furigana.astro';
import SectionHeading from '@/ui/SectionHeading.astro';

export const getStaticPaths = () => localeRoutes();

const locale = localeFromParams(Astro.params);
const t = useTranslations(locale);
---

<SiteLayout title={t.kana.title} description={t.kana.description}>
  <Container>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold tracking-tight">{t.kana.title}</h1>
        <p class="text-muted-foreground mt-2">{t.kana.description}</p>
      </div>

      <div
        class="bg-muted inline-flex rounded-lg p-1"
        role="group"
        aria-label={`${t.kana.hiragana} / ${t.kana.katakana}`}
      >
        <button
          type="button"
          data-script="hiragana"
          aria-pressed="true"
          class="kana-toggle rounded-md px-3 py-1.5 text-sm font-medium transition-colors"
        >
          {t.kana.hiragana}
        </button>
        <button
          type="button"
          data-script="katakana"
          aria-pressed="false"
          class="kana-toggle rounded-md px-3 py-1.5 text-sm font-medium transition-colors"
        >
          {t.kana.katakana}
        </button>
      </div>
    </div>

    <div id="kana-charts" data-script="hiragana" class="mt-8 space-y-12">
      <section>
        <SectionHeading title={t.kana.gojuon} />
        <KanaChart rows={GOJUON_ROWS} />
      </section>

      <section>
        <SectionHeading title={t.kana.dakuten} />
        <KanaChart rows={DAKUTEN_ROWS} />
      </section>

      <section>
        <SectionHeading title={t.kana.yoon} />
        <KanaChart rows={YOON_ROWS} columns={3} />
      </section>
    </div>

    {
      /* Outside #kana-charts: these marks apply to both scripts, so they stay
    visible whichever one is selected */
    }
    <section class="mt-12">
      <SectionHeading title={t.kana.marks} subtitle={t.kana.marksDescription} />
      <div class="grid gap-4 md:grid-cols-3">
        {
          KANA_MARKS.map((mark) => (
            <article class="bg-card rounded-lg border p-5">
              <p class="jp text-primary text-3xl leading-none" lang="ja">
                {mark.symbol}
              </p>
              <h3 class="mt-3 font-semibold">{pickLocale(mark.name, locale)}</h3>
              <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
                {pickLocale(mark.effect, locale)}
              </p>
              <ul class="mt-4 space-y-1.5 border-t pt-3 text-sm">
                {mark.examples.map((example) => (
                  <li class="flex flex-wrap items-baseline gap-x-2">
                    <span class="jp text-base" lang="ja">
                      <Furigana text={example.word} />
                    </span>
                    <span class="text-muted-foreground">{example.romaji}</span>
                    <span class="translation text-muted-foreground">
                      — {pickLocale(example.meaning, locale)}
                    </span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>
  </Container>
</SiteLayout>

<style>
  #kana-charts[data-script='hiragana'] :global(.kana-katakana),
  #kana-charts[data-script='katakana'] :global(.kana-hiragana) {
    display: none;
  }

  .kana-toggle[aria-pressed='true'] {
    background-color: var(--background);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.08);
  }

  .kana-toggle[aria-pressed='false'] {
    color: var(--muted-foreground);
  }
</style>

<script>
  // Lightweight script toggle; state is per-visit on purpose
  const setupKanaToggle = () => {
    const charts = document.getElementById('kana-charts');
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('.kana-toggle')];
    if (!charts || buttons.length === 0) return;

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        charts.dataset.script = button.dataset.script;
        buttons.forEach((other) => other.setAttribute('aria-pressed', String(other === button)));
      });
    });
  };

  // astro:page-load fires on the initial load and after every view transition
  document.addEventListener('astro:page-load', setupKanaToggle);
</script>
