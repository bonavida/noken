---
import { LOCALES } from '@/i18n/config';
import { localeFromParams, localeParam } from '@/i18n/routing';
import { ENABLED_LEVELS, type EnabledLevel } from '@/constants/levels';
import { localePath, pickLocale, useTranslations } from '@/i18n/t';
import SiteLayout from '@/layouts/SiteLayout.astro';
import Card from '@/ui/Card.astro';
import Container from '@/ui/Container.astro';
import Furigana from '@/ui/Furigana.astro';
import Icon, { type IconName } from '@/ui/Icon.astro';
import SectionHeading from '@/ui/SectionHeading.astro';
import { getCollection } from 'astro:content';

// One icon per topic slug, purely decorative (aria-hidden in Icon.astro)
const TOPIC_ICONS: Record<string, IconName> = {
  particles: 'link',
  numbers: 'hash',
  time: 'clock',
  calendar: 'calendar',
  counters: 'list-ordered',
  'question-words': 'help-circle',
  demonstratives: 'locate',
  family: 'users',
  adjectives: 'palette',
  greetings: 'message-circle',
};

export const getStaticPaths = () =>
  LOCALES.flatMap((locale) =>
    ENABLED_LEVELS.map((level) => ({ params: { lang: localeParam(locale), level } }))
  );

const { level } = Astro.params as { level: EnabledLevel };
const locale = localeFromParams(Astro.params);
const t = useTranslations(locale);

const topics = (await getCollection('reference', ({ data }) => data.level === level)).sort(
  (a, b) => a.data.order - b.data.order
);

const verbCount = (await getCollection('verbs', ({ data }) => data.level === level)).reduce(
  (total, entry) => total + entry.data.verbs.length,
  0
);
const kanjiCount = (await getCollection('kanji', ({ data }) => data.level === level)).length;

// The three browsable collections. They are not in the header any more, so this
// page is where they are found — hence the glyph and the count up front.
const collections = [
  {
    href: `/${level}/verbs`,
    glyph: '動詞[どうし]',
    title: t.verbs.title,
    stat: `${verbCount} ${t.verbs.resultCount}`,
    description: 'Formas ます, て, diccionario, ない y た de cada verbo del libro.',
  },
  {
    href: '/kana',
    glyph: 'あア',
    title: t.kana.title,
    stat: 'Hiragana y katakana',
    description: 'Gojūon, dakuten y combinaciones, con su romanización.',
  },
  {
    href: '/kanji',
    glyph: '漢字[かんじ]',
    title: t.kanji.title,
    stat: `${kanjiCount} kanji`,
    description: 'Lecturas on y kun, significados, trazos y palabras de ejemplo.',
  },
];
---

<SiteLayout title={t.reference.title} description={t.reference.description}>
  <Container>
    <h1 class="text-3xl font-bold tracking-tight">{t.reference.title}</h1>
    <p class="text-muted-foreground mt-2 max-w-2xl">{t.reference.description}</p>

    <section class="mt-10">
      <SectionHeading
        title={t.reference.collections}
        subtitle={t.reference.collectionsDescription}
      />
      <div class="grid gap-4 sm:grid-cols-3">
        {
          collections.map((collection) => (
            <Card href={collection.href} class="flex flex-col p-6">
              {/* min-height reserves the ruby line so glyphs without furigana still align */}
              <p class="jp text-primary flex min-h-12 items-end text-3xl leading-none" lang="ja">
                <Furigana text={collection.glyph} zoom={false} />
              </p>
              <h3 class="mt-4 text-lg font-semibold">{collection.title}</h3>
              <p class="text-primary text-sm font-medium">{collection.stat}</p>
              <p class="text-muted-foreground mt-2 text-sm">{collection.description}</p>
            </Card>
          ))
        }
      </div>
    </section>

    <section class="mt-12">
      <SectionHeading title={t.reference.tables} subtitle={t.reference.tablesDescription} />
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          topics.map(({ data }) => (
            <Card href={localePath(`/${level}/reference/${data.slug}`, locale)}>
              <div class="text-primary bg-accent/60 inline-flex size-9 items-center justify-center rounded-md">
                <Icon name={TOPIC_ICONS[data.slug]} class="size-5" />
              </div>
              <h3 class="mt-3 font-semibold">{pickLocale(data.title, locale)}</h3>
              <p class="text-muted-foreground mt-1 text-sm">
                {pickLocale(data.description, locale)}
              </p>
            </Card>
          ))
        }
      </div>
    </section>
  </Container>
</SiteLayout>
