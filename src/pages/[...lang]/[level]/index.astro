---
import { LOCALES } from '@/i18n/config';
import { localeFromParams, localeParam } from '@/i18n/routing';
import { ENABLED_LEVELS, type EnabledLevel } from '@/constants/levels';
import { localePath, useTranslations } from '@/i18n/t';
import SiteLayout from '@/layouts/SiteLayout.astro';
import Card from '@/ui/Card.astro';
import Container from '@/ui/Container.astro';
import { getCollection } from 'astro:content';

export const getStaticPaths = () =>
  LOCALES.flatMap((locale) =>
    ENABLED_LEVELS.map((level) => ({ params: { lang: localeParam(locale), level } }))
  );

const { level } = Astro.params as { level: EnabledLevel };
const locale = localeFromParams(Astro.params);
const t = useTranslations(locale);

const lessons = await getCollection('lessons', ({ data }) => data.level === level);
const vocab = await getCollection('vocab', ({ data }) => data.level === level);
const kanji = await getCollection('kanji', ({ data }) => data.level === level);
const verbEntries = await getCollection('verbs', ({ data }) => data.level === level);
const topics = await getCollection('reference', ({ data }) => data.level === level);

const wordCount = vocab.reduce((total, entry) => total + entry.data.words.length, 0);
const verbCount = verbEntries.reduce((total, entry) => total + entry.data.verbs.length, 0);
const levelName = level.toUpperCase();
---

<SiteLayout title={levelName} description={`${t.level.title} ${levelName} — ${t.site.description}`}>
  <Container>
    <h1 class="text-3xl font-bold tracking-tight">{t.level.title} {levelName}</h1>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <Card href={localePath(`/${level}/lessons`, locale)}>
        <p class="text-primary text-3xl font-bold">{lessons.length}</p>
        <h2 class="mt-1 font-semibold">{t.nav.lessons}</h2>
        <p class="text-muted-foreground mt-1 text-sm">{t.level.lessonsDescription}</p>
      </Card>

      <Card href={localePath(`/${level}/vocabulary`, locale)}>
        <p class="text-primary text-3xl font-bold">{wordCount}</p>
        <h2 class="mt-1 font-semibold">{t.nav.vocabulary}</h2>
        <p class="text-muted-foreground mt-1 text-sm">{t.level.vocabularyDescription}</p>
      </Card>

      <Card href={localePath('/kanji', locale)}>
        <p class="text-primary text-3xl font-bold">{kanji.length}</p>
        <h2 class="mt-1 font-semibold">{t.nav.kanji}</h2>
        <p class="text-muted-foreground mt-1 text-sm">{t.level.kanjiDescription}</p>
      </Card>

      <Card href={localePath(`/${level}/verbs`, locale)}>
        <p class="text-primary text-3xl font-bold">{verbCount}</p>
        <h2 class="mt-1 font-semibold">{t.nav.verbs}</h2>
        <p class="text-muted-foreground mt-1 text-sm">{t.verbs.description}</p>
      </Card>

      <Card href={localePath(`/${level}/reference`, locale)}>
        <p class="text-primary text-3xl font-bold">{topics.length}</p>
        <h2 class="mt-1 font-semibold">{t.nav.reference}</h2>
        <p class="text-muted-foreground mt-1 text-sm">{t.reference.description}</p>
      </Card>
    </div>
  </Container>
</SiteLayout>
