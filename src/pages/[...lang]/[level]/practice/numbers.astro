---
import { NumbersDrill } from '@/components/practice/NumbersDrill';
import { LOCALES } from '@/i18n/config';
import { localeFromParams, localeParam } from '@/i18n/routing';
import { ENABLED_LEVELS, type EnabledLevel } from '@/constants/levels';
import { localePath, useTranslations } from '@/i18n/t';
import SiteLayout from '@/layouts/SiteLayout.astro';
import Container from '@/ui/Container.astro';

export const getStaticPaths = () =>
  LOCALES.flatMap((locale) =>
    ENABLED_LEVELS.map((level) => ({ params: { lang: localeParam(locale), level } }))
  );

const { level } = Astro.params as { level: EnabledLevel };
const locale = localeFromParams(Astro.params);
const t = useTranslations(locale);
---

<SiteLayout
  title={t.practice.modes.numbers.title}
  description={t.practice.modes.numbers.description}
>
  <Container class="max-w-3xl">
    <p class="text-sm">
      <a href={localePath(`/${level}/practice`, locale)} class="text-primary hover:underline"
        >← {t.practice.title}</a
      >
    </p>
    <h1 class="mt-4 text-3xl font-bold tracking-tight">{t.practice.modes.numbers.title}</h1>
    <p class="text-muted-foreground mt-2">{t.practice.modes.numbers.description}</p>

    <div class="mt-8">
      <NumbersDrill labels={t.practice.drill} client:load />
    </div>
  </Container>
</SiteLayout>
