---
import { Flashcards, type Deck } from '@/components/practice/Flashcards';
import { LOCALES } from '@/i18n/config';
import { localeFromParams, localeParam } from '@/i18n/routing';
import { ENABLED_LEVELS, type EnabledLevel } from '@/constants/levels';
import { localePath, pickLocale, pickLocaleList, useTranslations } from '@/i18n/t';
import SiteLayout from '@/layouts/SiteLayout.astro';
import Container from '@/ui/Container.astro';
import { getCollection } from 'astro:content';

export const getStaticPaths = () =>
  LOCALES.flatMap((locale) =>
    ENABLED_LEVELS.map((level) => ({ params: { lang: localeParam(locale), level } }))
  );

const { level } = Astro.params as { level: EnabledLevel };
const locale = localeFromParams(Astro.params);
const t = useTranslations(locale);

const vocab = (await getCollection('vocab', ({ data }) => data.level === level)).sort(
  (a, b) => a.data.lesson - b.data.lesson
);
const kanji = await getCollection('kanji', ({ data }) => data.level === level);
const verbs = (await getCollection('verbs', ({ data }) => data.level === level)).flatMap(
  (entry) => entry.data.verbs
);

const vocabDecks: Deck[] = vocab.map((entry) => ({
  id: `vocab-${entry.data.lesson}`,
  name: `${t.lessons.lesson} ${entry.data.lesson}`,
  cards: entry.data.words.map((word) => ({
    id: word.id,
    jp: word.word,
    es: pickLocale(word.meaning, locale),
    sub: word.kana,
  })),
}));

const kanjiDeck: Deck = {
  id: 'kanji',
  name: t.kanji.title,
  cards: kanji.map(({ data }) => ({
    id: data.character,
    jp: data.character,
    es: pickLocaleList(data.meanings, locale).join(', '),
    sub: [...data.onyomi, ...data.kunyomi].join('・'),
  })),
};

const verbDeck: Deck = {
  id: 'verbs',
  name: t.verbs.title,
  cards: verbs.map((verb) => ({
    id: verb.id,
    jp: verb.verb,
    es: pickLocale(verb.meaning, locale),
    sub: verb.dictionary,
  })),
};

const decks = [kanjiDeck, verbDeck, ...vocabDecks];
---

<SiteLayout
  title={t.practice.modes.flashcards.title}
  description={t.practice.modes.flashcards.description}
>
  <Container class="max-w-3xl">
    <p class="text-sm">
      <a href={localePath(`/${level}/practice`, locale)} class="text-primary hover:underline"
        >← {t.practice.title}</a
      >
    </p>
    <h1 class="mt-4 text-3xl font-bold tracking-tight">{t.practice.modes.flashcards.title}</h1>
    <p class="text-muted-foreground mt-2">{t.practice.modes.flashcards.description}</p>

    <div class="mt-8">
      <Flashcards decks={decks} labels={t.practice.cards} client:load />
    </div>
  </Container>
</SiteLayout>
