---
import IndexCard from '@/components/IndexCard.astro';
import LessonProgress from '@/components/LessonProgress.astro';
import { LOCALES } from '@/i18n/config';
import { localeFromParams, localeParam } from '@/i18n/routing';
import { ENABLED_LEVELS, type EnabledLevel } from '@/constants/levels';
import { localePath, pickLocale, useTranslations } from '@/i18n/t';
import SiteLayout from '@/layouts/SiteLayout.astro';
import Container from '@/ui/Container.astro';
import Icon from '@/ui/Icon.astro';
import { getCollection } from 'astro:content';

export const getStaticPaths = () =>
  LOCALES.flatMap((locale) =>
    ENABLED_LEVELS.map((level) => ({ params: { lang: localeParam(locale), level } }))
  );

const { level } = Astro.params as { level: EnabledLevel };
const locale = localeFromParams(Astro.params);
const t = useTranslations(locale);

const lessons = (await getCollection('lessons', ({ data }) => data.level === level)).sort(
  (a, b) => a.data.number - b.data.number
);
const vocab = await getCollection('vocab', ({ data }) => data.level === level);
const wordCountByLesson = new Map(
  vocab.map((entry) => [entry.data.lesson, entry.data.words.length])
);
---

<SiteLayout
  title={`${t.lessons.title} ${level.toUpperCase()}`}
  description={t.level.lessonsDescription}
>
  <Container>
    <h1 class="text-3xl font-bold tracking-tight">{t.lessons.title}</h1>
    <p class="text-muted-foreground mt-2">{t.level.lessonsDescription}</p>

    <LessonProgress
      level={level}
      total={lessons.length}
      label={t.practice.progressLabel}
      class="mt-6"
    />

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-lessons-grid data-level={level}>
      {
        lessons.map(({ data }) => (
          <div class="relative" data-lesson={data.number}>
            <IndexCard
              href={localePath(`/${level}/lessons/${data.number}`, locale)}
              number={data.number}
              label={t.lessons.lesson}
              title={pickLocale(data.title, locale)}
              meta={
                `${data.grammar.length} ${t.lessons.grammarPoints}` +
                (wordCountByLesson.has(data.number)
                  ? ` · ${wordCountByLesson.get(data.number)} ${t.lessons.words}`
                  : '')
              }
              accent="lessons"
            />
            <span
              class="bg-verb-3/10 text-verb-3 absolute top-5 right-5 hidden size-6 items-center justify-center rounded-full"
              data-completed-badge
              aria-hidden="true"
            >
              <Icon name="check" class="size-3.5" />
            </span>
          </div>
        ))
      }
    </div>
  </Container>
</SiteLayout>

<script>
  import { completedLessons } from '@/utils/progress';

  const update = () => {
    const grid = document.querySelector<HTMLElement>('[data-lessons-grid]');
    if (!grid) return;

    const done = new Set(completedLessons(grid.dataset.level ?? ''));
    grid.querySelectorAll<HTMLElement>('[data-lesson]').forEach((card) => {
      const badge = card.querySelector('[data-completed-badge]');
      const isDone = done.has(Number(card.dataset.lesson));
      badge?.classList.toggle('hidden', !isDone);
      badge?.classList.toggle('inline-flex', isDone);
    });
  };

  document.addEventListener('astro:page-load', update);
</script>
