---
import { localeFromParams, localeRoutes } from '@/i18n/routing';
import { ENABLED_LEVELS, isEnabledLevel, LEVELS } from '@/constants/levels';
import { SITE_NAME } from '@/constants/site';
import { localePath, useTranslations } from '@/i18n/t';
import SiteLayout from '@/layouts/SiteLayout.astro';
import Badge from '@/ui/Badge.astro';
import Card from '@/ui/Card.astro';
import Container from '@/ui/Container.astro';
import { getCollection } from 'astro:content';

export const getStaticPaths = () => localeRoutes();

const locale = localeFromParams(Astro.params);
const t = useTranslations(locale);

// The landing features the first enabled level; a level switcher can come later
const [defaultLevel] = ENABLED_LEVELS;

const lessons = await getCollection('lessons', ({ data }) => data.level === defaultLevel);
const vocab = await getCollection('vocab', ({ data }) => data.level === defaultLevel);
const kanji = await getCollection('kanji', ({ data }) => data.level === defaultLevel);
const verbs = await getCollection('verbs', ({ data }) => data.level === defaultLevel);
const topics = await getCollection('reference', ({ data }) => data.level === defaultLevel);

const wordCount = vocab.reduce((total, entry) => total + entry.data.words.length, 0);
const verbCount = verbs.reduce((total, entry) => total + entry.data.verbs.length, 0);

const lessonCountByLevel = new Map(
  ENABLED_LEVELS.map((level) => [
    level,
    lessons.filter((lesson) => lesson.data.level === level).length,
  ])
);

const features = [
  {
    href: `/${defaultLevel}/lessons`,
    title: t.nav.lessons,
    stat: `${lessons.length} ${t.home.lessonsCount}`,
    description: t.home.features.lessons,
  },
  {
    href: `/${defaultLevel}/vocabulary`,
    title: t.nav.vocabulary,
    stat: `${wordCount} ${t.lessons.words}`,
    description: t.home.features.vocabulary,
  },
  {
    href: `/${defaultLevel}/verbs`,
    title: t.nav.verbs,
    stat: `${verbCount} ${t.verbs.resultCount}`,
    description: t.home.features.verbs,
  },
  {
    href: '/kanji',
    title: t.nav.kanji,
    stat: `${kanji.length} kanji`,
    description: t.home.features.kanji,
  },
  {
    href: '/kana',
    title: t.nav.kana,
    stat: 'あ・ア',
    description: t.home.features.kana,
  },
  {
    href: `/${defaultLevel}/reference`,
    title: t.nav.reference,
    stat: `${topics.length} ${t.home.tablesCount}`,
    description: t.home.features.reference,
  },
];

// N5 first; the next two levels stay visible as "coming soon" teasers
const visibleLevels = LEVELS.slice(0, 3);
---

<SiteLayout title={SITE_NAME} description={t.site.description}>
  <Container>
    <section class="py-10 text-center sm:py-16">
      <p class="jp text-primary text-5xl sm:text-6xl" lang="ja">日本語</p>
      <h1 class="mt-5 text-3xl font-bold tracking-tight text-balance sm:text-5xl">
        {t.home.title}
      </h1>
      <p class="text-muted-foreground mx-auto mt-4 max-w-xl text-balance sm:text-lg">
        {t.home.subtitle}
      </p>
      <div class="mt-7 flex flex-wrap justify-center gap-3">
        {
          /* Ships as "start with lesson 1"; the script retargets it to the first
        pending lesson, or to the practice hub once every lesson is done */
        }
        <a
          href={localePath(`/${defaultLevel}/lessons/1`, locale)}
          data-cta-lessons
          data-level={defaultLevel}
          data-prefix={localePath('', locale)}
          data-total={lessons.length}
          data-label-continue={t.home.ctaContinue}
          data-label-completed={t.home.ctaCompleted}
          class="bg-primary text-primary-foreground hover:bg-primary/90 rounded-md px-5 py-2.5 text-sm font-medium transition-colors"
        >
          {t.home.ctaStart}
        </a>
        <a
          href={localePath(`/${defaultLevel}`, locale)}
          class="bg-secondary text-secondary-foreground hover:bg-secondary/80 rounded-md px-5 py-2.5 text-sm font-medium transition-colors"
        >
          {t.home.ctaLevel}
        </a>
      </div>
    </section>

    <section class="mt-4">
      <h2 class="mb-4 text-xl font-semibold">{t.home.whatsInside}</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          features.map((feature) => (
            <Card href={feature.href}>
              <div class="flex items-baseline justify-between gap-2">
                <h3 class="font-semibold">{feature.title}</h3>
                <span class="jp text-primary text-sm font-medium" lang="ja">
                  {feature.stat}
                </span>
              </div>
              <p class="text-muted-foreground mt-2 text-sm">{feature.description}</p>
            </Card>
          ))
        }
      </div>
    </section>

    <section class="mt-12">
      <h2 class="mb-4 text-xl font-semibold">{t.home.chooseLevel}</h2>
      <div class="grid gap-4 sm:grid-cols-3">
        {
          visibleLevels.map((level) =>
            isEnabledLevel(level) ? (
              <Card href={localePath(`/${level}`, locale)}>
                <p class="text-2xl font-bold uppercase">{level}</p>
                <p class="text-muted-foreground mt-1 text-sm">
                  {lessonCountByLevel.get(level)} {t.home.lessonsCount}
                </p>
              </Card>
            ) : (
              <Card class="opacity-60">
                <p class="text-2xl font-bold uppercase">{level}</p>
                <Badge variant="outline" class="mt-1">
                  {t.home.comingSoon}
                </Badge>
              </Card>
            )
          )
        }
      </div>
    </section>
  </Container>
</SiteLayout>

<script>
  import { completedLessons } from '@/utils/progress';

  const update = () => {
    const cta = document.querySelector<HTMLAnchorElement>('[data-cta-lessons]');
    if (!cta) return;

    const {
      level = '',
      prefix = '',
      total = '0',
      labelContinue = '',
      labelCompleted = '',
    } = cta.dataset;
    const done = new Set(completedLessons(level));
    if (done.size === 0) return;

    const numbers = Array.from({ length: Number(total) }, (_, index) => index + 1);
    const next = numbers.find((number) => !done.has(number));

    if (!next) {
      cta.href = `${prefix}/${level}/practice`;
      cta.textContent = labelCompleted;
      return;
    }
    cta.href = `${prefix}/${level}/lessons/${next}`;
    cta.textContent = labelContinue.replace('{n}', String(next));
  };

  document.addEventListener('astro:page-load', update);
</script>
