---
import IndexCard from '@/components/IndexCard.astro';
import { ENABLED_LEVELS, type EnabledLevel } from '@/constants/levels';
import { pickLocale, resolveLocale, useTranslations } from '@/i18n/t';
import SiteLayout from '@/layouts/SiteLayout.astro';
import Container from '@/ui/Container.astro';
import { getCollection } from 'astro:content';

export const getStaticPaths = () => ENABLED_LEVELS.map((level) => ({ params: { level } }));

const { level } = Astro.params as { level: EnabledLevel };
const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);

const lessons = (await getCollection('lessons', ({ data }) => data.level === level)).sort(
  (a, b) => a.data.number - b.data.number
);
const vocab = await getCollection('vocab', ({ data }) => data.level === level);
const wordCountByLesson = new Map(
  vocab.map((entry) => [entry.data.lesson, entry.data.words.length])
);
---

<SiteLayout
  title={`${t.lessons.title} ${level.toUpperCase()}`}
  description={t.level.lessonsDescription}
>
  <Container>
    <h1 class="text-3xl font-bold tracking-tight">{t.lessons.title}</h1>
    <p class="text-muted-foreground mt-2">{t.level.lessonsDescription}</p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        lessons.map(({ data }) => (
          <IndexCard
            href={`/${level}/lessons/${data.number}`}
            number={data.number}
            label={t.lessons.lesson}
            title={pickLocale(data.title, locale)}
            meta={
              `${data.grammar.length} ${t.lessons.grammarPoints}` +
              (wordCountByLesson.has(data.number)
                ? ` · ${wordCountByLesson.get(data.number)} ${t.lessons.words}`
                : '')
            }
            accent="lessons"
          />
        ))
      }
    </div>
  </Container>
</SiteLayout>
