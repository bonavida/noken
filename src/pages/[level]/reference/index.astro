---
import { ENABLED_LEVELS, type EnabledLevel } from '@/constants/levels';
import { pickLocale, resolveLocale, useTranslations } from '@/i18n/t';
import SiteLayout from '@/layouts/SiteLayout.astro';
import Card from '@/ui/Card.astro';
import Container from '@/ui/Container.astro';
import { getCollection } from 'astro:content';

export const getStaticPaths = () => ENABLED_LEVELS.map((level) => ({ params: { level } }));

const { level } = Astro.params as { level: EnabledLevel };
const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);

const topics = (await getCollection('reference', ({ data }) => data.level === level)).sort(
  (a, b) => a.data.order - b.data.order
);

const verbCount = (await getCollection('verbs', ({ data }) => data.level === level)).reduce(
  (total, entry) => total + entry.data.verbs.length,
  0
);
const kanjiCount = (await getCollection('kanji', ({ data }) => data.level === level)).length;

// The standalone guides come first: they are no longer in the header, so this
// page is where they are discovered.
const guides = [
  {
    href: `/${level}/verbs`,
    title: t.verbs.title,
    description: `${verbCount} ${t.verbs.resultCount} con sus formas ます, て, diccionario, ない y た.`,
  },
  { href: '/kana', title: t.kana.title, description: t.kana.description },
  {
    href: '/kanji',
    title: t.kanji.title,
    description: `${kanjiCount} kanji con lecturas, significados y ejemplos.`,
  },
];
---

<SiteLayout title={t.reference.title} description={t.reference.description}>
  <Container>
    <h1 class="text-3xl font-bold tracking-tight">{t.reference.title}</h1>
    <p class="text-muted-foreground mt-2 max-w-2xl">{t.reference.description}</p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        guides.map((guide) => (
          <Card href={guide.href}>
            <h2 class="font-semibold">{guide.title}</h2>
            <p class="text-muted-foreground mt-1 text-sm">{guide.description}</p>
          </Card>
        ))
      }

      {
        topics.map(({ data }) => (
          <Card href={`/${level}/reference/${data.slug}`}>
            <h2 class="font-semibold">{pickLocale(data.title, locale)}</h2>
            <p class="text-muted-foreground mt-1 text-sm">{pickLocale(data.description, locale)}</p>
          </Card>
        ))
      }
    </div>
  </Container>
</SiteLayout>
