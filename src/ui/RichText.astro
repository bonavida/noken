---
import MixedText from '@/ui/MixedText.astro';

// Multi-paragraph text mixing Spanish and Japanese (grammar explanations).
interface Props {
  text: string;
  class?: string;
}

const { text, class: className } = Astro.props;
const paragraphs = text
  .split('\n\n')
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);
---

{
  paragraphs.map((paragraph) => (
    <p class={className}>
      <MixedText text={paragraph} />
    </p>
  ))
}
