---
import { parseFurigana } from '@/utils/furigana';

interface Props {
  text: string;
  // Display-size glyphs are already legible, so they opt out of the hover zoom
  zoom?: boolean;
}

const { text, zoom = true } = Astro.props;
const segments = parseFurigana(text);
---

<span class="jp" lang="ja">
  {
    segments.map((segment) =>
      segment.ruby ? (
        <span class={zoom ? 'ruby-word' : undefined}>
          <ruby>
            {segment.base}
            <rp>(</rp>
            <rt>{segment.ruby}</rt>
            <rp>)</rp>
          </ruby>
        </span>
      ) : (
        segment.base
      )
    )
  }
</span>
