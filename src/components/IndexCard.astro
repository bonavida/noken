---
import { cn } from '@/utils/cn';

// A lesson/vocabulary grid card: a colored numeral chip plus title and meta.
// Each section gets its own accent so the two grids read as distinct.
type Accent = 'lessons' | 'vocab';

interface Props {
  href: string;
  number: number;
  label: string;
  title: string;
  meta: string;
  accent: Accent;
}

const { href, number, label, title, meta, accent } = Astro.props;

// Full static class strings — Tailwind cannot see interpolated color names
const accents: Record<Accent, { chip: string; hover: string }> = {
  lessons: {
    chip: 'bg-primary/10 text-primary',
    hover: 'hover:border-primary/40 hover:bg-primary/[0.04]',
  },
  vocab: {
    chip: 'bg-sky/10 text-sky',
    hover: 'hover:border-sky/40 hover:bg-sky/[0.04]',
  },
};

const { chip, hover } = accents[accent];
---

<a
  href={href}
  class={cn(
    'group focus-visible:ring-ring block rounded-lg border bg-card p-5 text-card-foreground transition-colors focus-visible:ring-2',
    hover
  )}
>
  <div class="flex items-center gap-2.5">
    <span
      class={cn(
        'inline-flex size-8 shrink-0 items-center justify-center rounded-md text-sm font-bold tabular-nums',
        chip
      )}
    >
      {number}
    </span>
    <span class="text-muted-foreground text-sm font-medium">{label}</span>
  </div>

  <h2 class="mt-3 text-lg font-semibold">{title}</h2>
  <p class="text-muted-foreground mt-1 text-sm">{meta}</p>
</a>
