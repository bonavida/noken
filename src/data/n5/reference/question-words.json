              "何[なに]／何[なん]",
              {
                "es": "qué"
              },
              "何[なに]を 買[か]いますか。"
            ],
            [
              "誰[だれ]",
              {
                "es": "quién"
              },
              "あの 人[ひと]は 誰[だれ]ですか。"
            ],
            [
              "どなた",
              {
                "es": "quién (cortés)"
              },
              "どなたですか。"
            ],
            [
              "どれ",
              {
                "es": "cuál (entre tres o más)"
              },
              "どれが 山田[やまだ]さんの 傘[かさ]ですか。"
            ],
            [
              "どの〜",
              {
                "es": "cuál ~ (entre tres o más)"
              },
              "どの 人[ひと]ですか。"
            ],
            [
              "どちら",
              {
                "es": "cuál (entre dos); también «por dónde»"
              },
              "夏[なつ]と 冬[ふゆ]とどちらが 好[す]きですか。"
            ],
            [
              "どんな〜",
              {
                "es": "qué clase de ~"
              },
              "どんな 音楽[おんがく]が 好[す]きですか。"
            ]
          ]
        }
